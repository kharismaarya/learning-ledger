# Copy this file to .env and paste your Neon connection string below.
# .env is gitignored: it holds your database password, so it must never be committed (the repo is public).
# Neon console → your project → pick the "dev" branch → Connect → copy the connection string.
# Use the dev branch here. The "main" branch holds your live data and is used only by the Render deploy.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full

# Leave HOST unset on your computer: the app then only listens on this computer (it's set on Render, see render.yaml).
# Locally you sign in with an account too. Make one on the sign-in page: it lives in the dev branch, not in main.
